PORT=8080
MONGO_URI=mongodb://localhost:27017/thiago_exchange?replicaSet=rs0
MONGO_DB_NAME=thiago_exchange
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGIN=http://localhost:3000

# Bybit — public market data works with no keys. Private endpoints (wallet
# balance, used by the admin console) return "not configured" until these
# are set.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com

# Reference rate used to convert Bybit's USDT prices into NGN for floating-
# rate ads, until a live FX feed is wired up.
USD_NGN_RATE=1550

STORAGE_DIR=./data/uploads

# Comma-separated allowlist: any of these emails automatically becomes an
# admin the moment they register or log in — no separate seeded account.
ADMIN_EMAILS=admin@thiagoexchange.com

# Transactional emails (welcome, order opened, order completed). Leave
# blank to disable — the app runs fine without them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Thiago Exchange

# This service's own public URL. Set on Render so it can self-ping every
# 14 minutes and avoid the free tier's 15-minute idle sleep. Leave blank
# for local dev.
BACKEND_URL=
